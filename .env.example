# ==============================================================================
# BAITSCOPE Threat Intelligence & Cyber Deception Platform — Environment Config
# Version: 5.0 | Tagline: Deceive. Detect. Investigate.
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env:
#    cp .env.example .env
# 2. Replace ALL placeholder values with unique, high-entropy secrets.
# 3. Never commit your .env file to version control.
# ==============================================================================

# --- Administrator Authentication & Secrets ---
# Require explicit non-default secrets at startup in production (1 = enforce)
BAITSCOPE_STRICT_SECRETS=0

# Minimum 32-character high-entropy secret key for signing admin HMAC session tokens.
# If omitted in non-strict mode, an ephemeral secret is generated per restart.
BAITSCOPE_ADMIN_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_32_CHARS_MIN

# Explicitly authorized administrator username
BAITSCOPE_ADMIN_USERNAME=admin

# Administrator Password (used to derive PBKDF2 hash on initial setup)
# Set either BAITSCOPE_ADMIN_PASSWORD or BAITSCOPE_ADMIN_PASSWORD_HASH
BAITSCOPE_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_ADMIN_PASSWORD

# Optional: Pre-calculated PBKDF2-HMAC-SHA256 password hash (100,000 iterations)
# BAITSCOPE_ADMIN_PASSWORD_HASH=

# Salt used for administrator password hashing
BAITSCOPE_ADMIN_SALT=CHANGE_THIS_TO_A_UNIQUE_ADMIN_SALT

# Session lifetime (seconds) and PBKDF2 iteration count
BAITSCOPE_SESSION_MAX_AGE=86400
BAITSCOPE_PBKDF2_ITERATIONS=100000

# --- Public Decoy Secrets ---
# Secret key & salt used for signing decoy user sessions
BAITSCOPE_DECOY_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_DECOY_SECRET_KEY_32_CHARS_MIN
BAITSCOPE_DECOY_SALT=CHANGE_THIS_TO_A_UNIQUE_DECOY_SALT

# --- Quarantine & Upload Protection ---
# Maximum allowable upload size in bytes (Default: 5242880 = 5 Megabytes)
MAX_UPLOAD_SIZE_BYTES=5242880

# --- Dashboard Host & Port Isolation ---
# Dashboard binding interface: 127.0.0.1 restricts admin dashboard to localhost.
# Set to 0.0.0.0 only behind a trusted reverse proxy or VPN tunnel.
BAITSCOPE_DASHBOARD_HOST=127.0.0.1
BAITSCOPE_DASHBOARD_PORT=8080

# Decoy ports (Default 443 with automatic fallback to 8443)
BAITSCOPE_DECOY_PORT=443
BAITSCOPE_DECOY_FALLBACK_PORT=8443

# --- Trusted Reverse Proxies & Storage ---
# Comma-separated IPs or CIDRs permitted to supply X-Forwarded-For / X-Real-IP
# Leave unset/empty for direct-peer zero-trust IP attribution.
# BAITSCOPE_TRUSTED_PROXIES=127.0.0.1,::1

# Optional custom SQLite database file path (Default: ./database/honeypot.db)
# BAITSCOPE_DATABASE_PATH=./database/honeypot.db

# --- Remote Node Webhook Authentication ---
# Optional shared bearer token for remote decoy nodes forwarding logs to /api/remote-log
# BAITSCOPE_REMOTE_LOG_KEY=CHANGE_THIS_TO_A_SECURE_WEBHOOK_BEARER_TOKEN

# --- Backward-Compatibility Fallbacks (Legacy SENTINEL_* Supported) ---
# SENTINEL_STRICT_SECRETS=
# SENTINEL_ADMIN_SECRET_KEY=
# SENTINEL_ADMIN_USERNAME=
# SENTINEL_ADMIN_PASSWORD=
# SENTINEL_ADMIN_PASSWORD_HASH=
# SENTINEL_ADMIN_SALT=
# SENTINEL_DECOY_SECRET_KEY=
# SENTINEL_DECOY_SALT=
# SENTINEL_DASHBOARD_HOST=127.0.0.1
# SENTINEL_DASHBOARD_PORT=8080
# SENTINEL_DECOY_PORT=443
# SENTINEL_DECOY_FALLBACK_PORT=8443
# SENTINEL_TRUSTED_PROXIES=
# SENTINEL_DATABASE_PATH=
# SENTINEL_REMOTE_LOG_KEY=
