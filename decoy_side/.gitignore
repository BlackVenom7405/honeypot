# ==============================================================================
# Git Ignore — BAITSCOPE Standalone Decoy Node (v5.0)
# ==============================================================================

__pycache__/
*.py[cod]
venv/
.venv/

# TLS Keys & Certificates (generated locally on startup)
*.pem
*.key
*.crt
cert.pem
key.pem

# Database Storage
*.db
*.sqlite
*.sqlite3
database/*
!database/.gitkeep

# Runtime Logs & Quarantined Malware Samples
logs/*
!logs/.gitkeep
*.log
uploads/*
!uploads/quarantine/
uploads/quarantine/*
!uploads/quarantine/.gitkeep

# Environment Variables & IDE / OS
.env
.env.*
!.env.example
.vscode/
.DS_Store
Thumbs.db
.vercel/
