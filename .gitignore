# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
database/*
!database/.gitkeep
decoy_side/database/*
!decoy_side/database/.gitkeep

# ------------------------------------------------------------------------------
# 7. Runtime Logs & Telemetry Captures
# ------------------------------------------------------------------------------
logs/*
!logs/.gitkeep
decoy_side/logs/*
!decoy_side/logs/.gitkeep
*.log

# ------------------------------------------------------------------------------
# 8. Uploaded Files & Quarantined Malware Samples
# ------------------------------------------------------------------------------
uploads/*
!uploads/quarantine/
uploads/quarantine/*
!uploads/quarantine/.gitkeep
decoy_side/uploads/*
!decoy_side/uploads/quarantine/
decoy_side/uploads/quarantine/*
!decoy_side/uploads/quarantine/.gitkeep

