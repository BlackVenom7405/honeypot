# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
decoy_side/.env
decoy_side/.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
cert.pem
key.pem
decoy_side/cert.pem
decoy_side/key.pem

