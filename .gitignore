# ==============================================================================
# Git Ignore — BAITSCOPE Cyber Deception & Threat Intelligence Platform (v5.0)
# Excludes non-runtime artifacts, research materials, tests, ML leftovers,
# local databases, quarantine samples, logs, and environment secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
decoy_side/venv/
decoy_side/.venv/
decoy_side/__pycache__/

# ------------------------------------------------------------------------------
# 2. Testing, Verification & Audit Artifacts
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
audit_output/
tests/
test_results/
playwright-report/
test-results/
*_test_results.json
phase*_results.json

